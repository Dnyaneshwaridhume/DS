#include <iostream>
#include <stack>
#include <string>

int main() {
    // Create a stack to store order numbers
    std::stack<std::string> cancelledOrders;

    // Simulate adding 5 cancelled order numbers (older to newer)
    cancelledOrders.push("ORD1001");
    cancelledOrders.push("ORD1002");
    cancelledOrders.push("ORD1003");
    cancelledOrders.push("ORD1004");
    cancelledOrders.push("ORD1005"); // Most recently cancelled
 Most recently cancelled

    std::cout << "--- Displaying Cancelled Orders (Most Recent First) ---\n";

    // Process and display until the stack is empty
    while (!cancelledOrders.empty()) {
        // Display the top element (most recent)
        std::cout << "Cancelled Order: " << cancelledOrders.top() << std::endl;
        
        // Remove the top element to access the next one
        cancelledOrders.pop();
    }

    return 0;
}

Use code with caution.
How it works

    std::stack<std::string> creates a standard LIFO data structure.
    .push() inserts the order numbers into the stack. ORD1005 sits at the very top because it was added last.
    .top() reads the element currently at the top of the stack without removing it.
    .pop() removes the top element so the program can look at the next most recent order in the next loop iteration.

